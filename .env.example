# Copy to .env and fill in the two placeholder values.

# Postgres connection. Local dev uses localhost; production points at Lb01's
# private address.
DATABASE_URL=postgresql://r3:CHANGE_ME@localhost:5432/r3

# MusicBrainz requires a descriptive User-Agent with working contact details.
# Requests without one are blocked. No API key is needed.
# Format: AppName/version ( contact )
MB_USER_AGENT=RoyaltyReadinessReport/1.0 ( your-contact-here )

# Do not lower. MusicBrainz allows one request per second.
MB_RATE_LIMIT_SECONDS=1.0

# Days before a cached profile is re-checked upstream.
STALE_AFTER_DAYS=60

# true on Web01 only. Never on Web02 — two workers double the outbound
# rate to MusicBrainz and get the app blocked.
RUN_WORKER=false

# true only when running behind the nginx load balancer, where the rate
# limiter must read the client IP from X-Forwarded-For. Leave false for local
# development and for any server reachable directly: trusting the header when
# nothing sets it lets a caller forge a new identity on every request.
TRUST_PROXY_HEADERS=false

LOG_LEVEL=info
